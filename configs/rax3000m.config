# ============================================================
# 目标平台与设备
# ============================================================

# 选择目标平台为 Mediatek
CONFIG_TARGET_mediatek=y
# 选择目标平台的子目标为 Filogic (24.10 起 MT7981 归入 filogic，不再有 mt7981 子目标)
CONFIG_TARGET_mediatek_filogic=y
# 启用多配置文件支持 (允许多个不同的固件配置)
CONFIG_TARGET_MULTI_PROFILE=y
# 为每个设备构建单独的根文件系统
CONFIG_TARGET_PER_DEVICE_ROOTFS=y


# --- CMCC RAX3000M ---

# 选择目标设备为 CMCC RAX3000M
# 24.10 上游只有一个 cmcc_rax3000m profile：SPI-NAND 与 eMMC 两套 preloader/fip
# 和 emmc-gpt.bin 由同一次构建一起产出 (target/linux/mediatek/image/filogic.mk)
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_rax3000m=y
# 为 CMCC RAX3000M 设备指定要包含的软件包 (无线驱动与 USB 工具已在 DEVICE_PACKAGES 里，留空)
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_cmcc_rax3000m=""


# ============================================================
# 构建系统
# ============================================================

# ---------- 已启用 ----------

# 启用开发者选项 (CONFIG_CCACHE 是 bool "Use ccache" if DEVEL，工作流追加 CCACHE=y 依赖这一行)
CONFIG_DEVEL=y
# 启用工具链选项 (允许自定义编译器选项)
CONFIG_TOOLCHAINOPTS=y
# 启用 Busybox 自定义配置 (允许选择要包含的 Busybox 功能)
CONFIG_BUSYBOX_CUSTOM=y
# 在 Busybox 中包含 blkid 命令
CONFIG_BUSYBOX_CONFIG_BLKID=y
# 在 Busybox 的 blkid 命令中启用类型检测功能
CONFIG_BUSYBOX_CONFIG_FEATURE_BLKID_TYPE=y
# 在 Busybox 中包含 volumeid 命令
CONFIG_BUSYBOX_CONFIG_VOLUMEID=y
# 启用包含配置文件 (把编译配置写进固件 /etc/build.info)
CONFIG_INCLUDE_CONFIG=y
# 在 JSON 概述中包含镜像信息
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
# 启用软件包 FORTIFY_SOURCE 2 (提供额外的安全检查)
CONFIG_PKG_FORTIFY_SOURCE_2=y


# ============================================================
# 内核选项
# ============================================================

# ---------- 已启用 ----------

# 无显式内核开关：24.10 的 filogic 使用上游 config-6.6，
# 应用所需内核模块全部由下面"软件包 - 内核模块"分区的 kmod-* 带入

# ---------- 未启用 ----------

# 关闭内核调试信息 (filogic 的 FEATURES 不含 small_flash，Config-kernel.in 的
# default y if !SMALL_FLASH 会生效；调试信息只落在 build_dir 的 vmlinux.debug，不进固件)
CONFIG_KERNEL_DEBUG_INFO=n


# ============================================================
# MTK WiFi 驱动
# ============================================================

# ---------- 已启用 ----------

# 本分区已删除：官方仓库的 MT7981 无线走内核态 mt76 (kmod-mt7915e +
# mt7981-wo-firmware，已在 DEVICE_PACKAGES 中)，没有 hanwckf 私有驱动的 CONFIG_MTK_* 开关


# ============================================================
# 网络连接基础设施与 WARP 加速
# ============================================================

# ---------- 已启用 ----------

# 本分区已删除：CONNINFRA/WARP/WED 系列开关属于 hanwckf 私有驱动，官方仓库无对应符号


# ============================================================
# 加密与 SSL
# ============================================================

# ---------- 已启用 ----------

# 无显式加密开关：OpenSSL 3.x 已移除 AF_ALG 引擎与 NPN 选项，硬件加速由内核 kmod-crypto-* 按需带入


# ============================================================
# 软件包 - 引导加载器
# ============================================================

# ---------- 未启用 ----------

# 关闭上游对 filogic 子目标默认全选的 UART 救砖 BL2 (各自只往 BIN_DIR 丢一个 mt79xx-ram-*-bl2.bin，本机型 SPI-NAND 引导用不到，砍掉可省 7 次 TFA 交叉编译)
CONFIG_PACKAGE_trusted-firmware-a-mt7981-ram-ddr3=n
CONFIG_PACKAGE_trusted-firmware-a-mt7981-ram-ddr4=n
CONFIG_PACKAGE_trusted-firmware-a-mt7986-ram-ddr3=n
CONFIG_PACKAGE_trusted-firmware-a-mt7986-ram-ddr4=n
CONFIG_PACKAGE_trusted-firmware-a-mt7988-ram-comb=n
CONFIG_PACKAGE_trusted-firmware-a-mt7988-ram-ddr3=n
CONFIG_PACKAGE_trusted-firmware-a-mt7988-ram-ddr4=n


# ============================================================
# 软件包 - 基础系统与工具
# ============================================================

# ---------- 已启用 ----------

# 安装 CA 证书软件包 (提供可信的 SSL 证书)
CONFIG_PACKAGE_ca-certificates=y
# 安装 ethtool 软件包 (用于查询和控制网络接口)
CONFIG_PACKAGE_ethtool=y
# 安装 htop 软件包 (提供交互式进程查看器)
CONFIG_PACKAGE_htop=y
# 安装 openssh-keygen 软件包 (提供 OpenSSH 密钥生成工具)
CONFIG_PACKAGE_openssh-keygen=y
# 安装 openssh-sftp-server 软件包 (提供 OpenSSH SFTP 服务器，dropbear 自身不带 sftp-server)
CONFIG_PACKAGE_openssh-sftp-server=y
# 安装 openssl-util 软件包 (提供 OpenSSL 命令行工具)
CONFIG_PACKAGE_openssl-util=y
# 安装 resolveip 软件包 (提供域名解析工具)
CONFIG_PACKAGE_resolveip=y
# 安装 tcpdump 软件包 (提供网络数据包分析工具)
CONFIG_PACKAGE_tcpdump=y
# 安装 terminfo 软件包 (提供终端信息数据库，ttyd 网页终端需要)
CONFIG_PACKAGE_terminfo=y
# 安装 zram-swap 软件包 (提供 zram 交换空间管理工具，缓解 512MB 内存压力)
CONFIG_PACKAGE_zram-swap=y

# ---------- 未启用 ----------

# 禁用 nano 软件包 (统一使用 vi，避免与 Busybox 编辑器重复占空间)
CONFIG_PACKAGE_nano=n


# ============================================================
# 软件包 - 网络与防火墙
# ============================================================

# ---------- 已启用 ----------

# 安装 dnsmasq-full 软件包 (完整版 DNS/DHCP 服务；OpenClash 的 DEPENDS 已声明，
# 这里显式写出以保证出厂用 full 变体。kconfig 符号名保留包名的连字符，写成下划线会被静默忽略)
CONFIG_PACKAGE_dnsmasq-full=y


# ============================================================
# 软件包 - 内核模块
# ============================================================

# 安装 kmod-usb-storage 内核模块 (USB 大容量存储，samba4 共享与 hd-idle 休眠的前置条件)
CONFIG_PACKAGE_kmod-usb-storage=y
# 安装 kmod-fs-vfat 内核模块 (提供 FAT/exFAT 系列文件系统支持，USB 硬盘常见格式)
CONFIG_PACKAGE_kmod-fs-vfat=y
# 安装 kmod-nls-utf8 内核模块 (提供 FAT 文件名的 UTF-8 转换，避免中文文件名乱码)
CONFIG_PACKAGE_kmod-nls-utf8=y


# ============================================================
# 软件包 - 库文件
# ============================================================

# 无手写库文件：各应用的依赖库 (libopenssl / libnl / libpcap 等) 均由上游 DEPENDS 带入


# ============================================================
# 网卡配置
# ============================================================

# 本分区已删除：CONFIG_first_card* 是 hanwckf 私有开关，官方仓库的 MT7981 交换芯片
# 由内核 DSA 驱动管理，没有对应的 kconfig 符号


# ============================================================
# 软件包 - LuCI 应用与主题
# ============================================================

# --- LuCI 核心界面 ---
# 安装 luci 软件包 (官方 24.10 的 LuCI 集合 = luci-light + luci-app-package-manager，
# 带出 luci-mod-admin-full / luci-app-firewall / uhttpd / bootstrap 主题)
CONFIG_PACKAGE_luci=y
# 启用 LuCI 简体中文翻译总开关 (luci.mk 用它给所有已选应用的 luci-i18n-*-zh-cn 打默认 y；
# 下面仍逐包显式列出，便于审计最终装进固件的语言包)
CONFIG_LUCI_LANG_zh_Hans=y
# 安装 luci-i18n-base-zh-cn 软件包 (提供 LuCI 核心运行时的中文语言包)
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
# 安装 luci-i18n-firewall-zh-cn 软件包 (提供 LuCI 防火墙设置界面的中文语言包)
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# --- Argon 主题 ---
# 安装 luci-theme-argon 软件包 (提供 Argon 主题)
CONFIG_PACKAGE_luci-theme-argon=y
# 安装 luci-app-argon-config 软件包 (提供 LuCI Argon 主题配置界面)
CONFIG_PACKAGE_luci-app-argon-config=y
# 安装 luci-i18n-argon-config-zh-cn 软件包 (提供 LuCI Argon 主题配置界面的中文语言包)
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# --- 在线升级 (Attended Sysupgrade) ---
# 安装 luci-app-attendedsysupgrade 软件包 (提供 LuCI 在线重编译/升级固件界面)
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
# 安装 luci-i18n-attendedsysupgrade-zh-cn 软件包 (提供 LuCI 在线升级界面的中文语言包)
CONFIG_PACKAGE_luci-i18n-attendedsysupgrade-zh-cn=y

# --- 定时自动重启 (autoreboot) ---
# 安装 luci-app-autoreboot 软件包 (提供 LuCI 定时自动重启设置界面)
CONFIG_PACKAGE_luci-app-autoreboot=y
# 安装 luci-i18n-autoreboot-zh-cn 软件包 (提供 LuCI 定时自动重启设置界面的中文语言包)
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y

# --- 网页终端 (TTYD) ---
# 安装 luci-app-ttyd 软件包 (提供 LuCI 网页终端设置界面，通过浏览器访问路由器 Shell)
CONFIG_PACKAGE_luci-app-ttyd=y
# 安装 luci-i18n-ttyd-zh-cn 软件包 (提供 LuCI 网页终端设置界面的中文语言包)
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# --- 系统监控 (statistics) ---
# 安装 luci-app-statistics 软件包 (提供 LuCI 基于 collectd + rrdtool 的图表监控界面)
CONFIG_PACKAGE_luci-app-statistics=y
# 安装 luci-i18n-statistics-zh-cn 软件包 (提供 LuCI 系统监控界面的中文语言包)
CONFIG_PACKAGE_luci-i18n-statistics-zh-cn=y

# --- 流控 (SQM) ---
# 安装 luci-app-sqm 软件包 (提供 LuCI SQM 队列整形界面，用 cake 算法抑制 bufferbloat)
CONFIG_PACKAGE_luci-app-sqm=y
# 安装 luci-i18n-sqm-zh-cn 软件包 (提供 LuCI 流控界面的中文语言包)
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y

# --- 磁盘管理 (DiskMan) ---
# 安装 luci-app-diskman 软件包 (提供 LuCI 磁盘分区/格式化/挂载管理界面)
CONFIG_PACKAGE_luci-app-diskman=y
# 安装 luci-i18n-diskman-zh-cn 软件包 (提供 LuCI 磁盘管理界面的中文语言包)
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
# 在 luci-app-diskman 中包含 btrfs-progs (btrfs 分区创建与检查；上游默认 y，显式写出便于审计)
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_btrfs_progs=y
# 在 luci-app-diskman 中包含 lsblk (界面读取块设备列表；上游默认 y，显式写出便于审计)
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_lsblk=y

# --- 硬盘休眠 (hd-idle) ---
# 安装 luci-app-hd-idle 软件包 (提供 LuCI 硬盘休眠设置界面，USB 挂载硬盘自动休眠)
CONFIG_PACKAGE_luci-app-hd-idle=y
# 安装 luci-i18n-hd-idle-zh-cn 软件包 (提供 LuCI 硬盘休眠设置界面的中文语言包)
CONFIG_PACKAGE_luci-i18n-hd-idle-zh-cn=y

# --- Samba4 文件共享 ---
# 安装 luci-app-samba4 软件包 (提供 LuCI Samba4 文件共享设置界面)
CONFIG_PACKAGE_luci-app-samba4=y
# 安装 luci-i18n-samba4-zh-cn 软件包 (提供 LuCI Samba4 文件共享设置界面的中文语言包)
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y

# --- OpenClash 代理客户端 ---
# 安装 luci-app-openclash 软件包 (提供 LuCI OpenClash 代理客户端界面)
# 该 feed 的 po 目录名为 zh-cn，luci.mk 的 LUCI_LANG 表里没有 zh-cn，
# 因此不会生成 luci-i18n-openclash-zh-cn；中文界面由 app 自身用 po2lmo 打进包内
CONFIG_PACKAGE_luci-app-openclash=y

# --- UPnP 自动端口映射 ---
# 安装 luci-app-upnp 软件包 (提供 LuCI UPnP 设置界面)
CONFIG_PACKAGE_luci-app-upnp=y
# 安装 luci-i18n-upnp-zh-cn 软件包 (提供 LuCI UPnP 设置界面的中文语言包)
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# --- SmartDNS 并发 DNS 解析 ---
# 安装 luci-app-smartdns 软件包 (提供 LuCI SmartDNS 管理界面)
CONFIG_PACKAGE_luci-app-smartdns=y
# 安装 luci-i18n-smartdns-zh-cn 软件包 (提供 LuCI SmartDNS 管理界面的中文语言包)
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

# --- 软件包管理 (在线安装/升级 ipk) ---
# 安装 luci-i18n-package-manager-zh-cn 软件包 (提供 LuCI 软件包管理界面的中文语言包)
# luci.mk 生成的 i18n 包 DEPENDS 就是对应 app，所以这一行会把 luci-app-package-manager 一起拉进固件
# 注：官方 24.10.6 的 USE_APK 仍 depends on BROKEN，固件包管理器是 opkg，界面名沿用 Package Manager
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# --- Lucky 大吉 ---
# 安装 luci-app-lucky 软件包 (提供 LuCI Lucky 管理界面，IPv6 端口转发/DDNS/公网访问)
# 来自 add-feed-sources.sh 追加的 lucky feed（固定提交），随 feeds install 自动就位
CONFIG_PACKAGE_luci-app-lucky=y
# 安装 luci-i18n-lucky-zh-cn 软件包 (提供 LuCI Lucky 管理界面的中文语言包)
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y


# ============================================================
# LuCI APP依赖
# ============================================================

# ---------- 已启用 ----------

# 无手写依赖兜底：24.10 feed 里 openclash 的 DEPENDS 已含 luci-compat / dnsmasq-full /
# bash / curl / ca-bundle / ip-full / ruby / ruby-yaml / kmod-inet-diag / kmod-nft-tproxy /
# kmod-tun / unzip，smartdns、ttyd、hd-idle、samba4、argon 同样只声明自身服务端

# ---------- 未启用 ----------

# 禁用 Ruby 的 YJIT (aarch64 默认 y，会经 ruby 的 PKG_BUILD_DEPENDS 拉入整套 rust 宿主工具链，
# 冷编约 2.5 小时；OpenClash 调用 ruby 时不带 --yjit，关掉不影响功能)
CONFIG_RUBY_ENABLE_YJIT=n

# 禁用默认 dnsmasq (与软件包分区里的 dnsmasq-full 冲突，两者都装 /etc/init.d/dnsmasq)
CONFIG_PACKAGE_dnsmasq=n
